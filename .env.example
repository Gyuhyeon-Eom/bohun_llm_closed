# docker compose 환경 예시 — 복사해서 .env로 (운영값은 폐쇄망에서 교체)
POSTGRES_USER=bohun
POSTGRES_PASSWORD=bohun
POSTGRES_DB=bohun
MINIO_ACCESS_KEY=bohun
MINIO_SECRET_KEY=bohun-secret
MINIO_PUBLIC_ENDPOINT=localhost:9000
LLM_BACKEND=mock
EMBED_BACKEND=hash
ORCH_BACKEND=langgraph
WITH_ML=0
OFFLINE=0
SEED_ON_START=1
DEMO_SEED=1
# ── FabriX OpenAPI 실규격 (docs/vendor/FabriX OpenAPI 매뉴얼.pdf, docs/FABRIX_API.md 참조) ──
# 이 5줄만 채우면 LLM·보안필터·파싱이 실규격 경로로 전부 연결된다 (경로 자동 유도)
FABRIX_BASE_URL=            # OpenAPI 신청 시 발급 URL (…/openapi/* 의 뿌리)
FABRIX_CLIENT_KEY=          # x-fabrix-client
FABRIX_PASS_KEY=            # x-openapi-token (Bearer 프리픽스 자동 부여)
FABRIX_MODEL_ID_MAIN=       # gpt-oss-120b modelId (GET /openapi/llm/v1/models)
FABRIX_MODEL_ID_LIGHT=      # gemma-4-31b modelId
FABRIX_USER_EMAIL=          # x-generative-ai-user-email (선택)
# I2T 이미지 분석(--transcriber fabrix 시): TEXT+I2T 모델 UUID (GET /openapi/chat/v1/all-models)
FABRIX_TEXT_MODEL_ID=
FABRIX_I2T_MODEL_ID=
# 모델명(로깅·캐시 키·라우팅 표시용)
LLM_MODEL_MAIN=gpt-oss-120b
LLM_MODEL_LIGHT=gemma-4-31b
SECURITY_FILTER_MODE=in,out
# 개별 엔드포인트 덮어쓰기(선택 — 발급 URL 구조가 다를 때만): FABRIX_ENDPOINT/PARSING_API/SECURITY_FILTER_API
# FabriX 미제공이라 별도 서빙 확보 시만: CHUNKING_API / EMBEDDING_API / RERANK_API
PLATFORM_API_KEY=           # (구형 Bearer 개발 서빙용 — FABRIX_CLIENT_KEY 설정 시 무시)

# ── 상주 워커·업무외시간 배치 (compose up -d 시 worker가 자동 부트스트랩) ──
LINK_SRC_DSN=               # 통합보훈 읽기 DSN (미설정=개발 모드: data/link_inbox 폴링)
LINK_POLL_S=60              # 연계 큐 폴링 주기(초)
BATCH_WINDOW=18:00-08:00    # 무거운 단계(VLM추출·임베딩)·업로드 수신함 허용 시간대. 빈값=상시
BATCH_WEEKEND=1             # 주말 종일 허용
BATCH_STEPS=VLM추출,임베딩   # 윈도우 게이트 대상 단계. 빈값=게이트 없음
VLM_CONCURRENCY=2           # GPU 서빙 동시성에 맞춰 조정
UPLOAD_PREFIX=inbox/        # MinIO 대량 수신함 프리픽스 — mc mirror로 40만 건 사전 적재 경로. 빈값=비활성
UPLOAD_SWEEP_MAX=200        # 수신함 1순회 처리 상한 (파일마다 윈도우 재확인)
TRANSCRIBER=vlm             # 워커 전사 백엔드: vlm(자체 GPU)/fabrix(I2T API)/parsing(Parsing API)
INDEX_SKIP_TYPES=ADM,APP    # 분류 결과 색인 제외 유형(신분·행정, 신청서식) — 전사·보존은 유지
